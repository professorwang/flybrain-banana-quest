# 上游只读克隆（社区项目 snedea/flybrain，MIT）
vendor/
# 例外：游戏自带的第三方库（three.js 本地化，必须入库）
!game/vendor/
!game/vendor/**

# Python
__pycache__/
*.py[cod]

# Node（本项目零依赖，防御性忽略）
node_modules/
package-lock.json
yarn.lock

# 日志与临时文件
*.log
*.tmp
*.bak
.DS_Store
Thumbs.db
desktop.ini

# 编辑器
.idea/
.vscode/

# 符号翻转实验变体数据（可用 python game/tools/flyb_to_bin.py --glut-excitatory 重建）
game/data/connectome-malecns-glutexc.bin.gz
game/data/connectome-flywire-glutinh.bin.gz
# 对照实验中间表（python game/tools/export_sign_tables.py 重建）
game/data/derived/

# LaTeX 构建产物
game/docs/arxiv/*.aux
game/docs/arxiv/*.out
game/docs/arxiv/*.log
